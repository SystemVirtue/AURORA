# AURORA local / deployment configuration
AURORA_ENV=development
AURORA_HOST=127.0.0.1
AURORA_PORT=8000

# Supabase / Postgres
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# MVP LLM providers
# OpenRouter is the recommended primary gateway provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Deferred provider integrations (documented for future work; not required by MVP)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default gateway model. Keep provider-specific IDs out of application code.
AURORA_DEFAULT_MODEL=
AURORA_EMBEDDING_MODEL=text-embedding-3-small
AURORA_REASONING_MODE=balanced

# Optional QUORUM contributors (comma-separated, maximum 3 per deliberation)
AURORA_QUORUM_MODELS=

# Browser-hosted UI integration.
# Comma-separated exact origins, e.g.
# https://your-app.lovable.app,https://your-custom-domain.example
# Leave empty for same-origin/local deployments.
AURORA_CORS_ORIGINS=

# Optional local Ollama endpoint (deferred from MVP)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Never commit real secrets. Provider keys belong only in the API runtime.
