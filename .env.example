# AURORA local configuration
AURORA_ENV=development
AURORA_HOST=127.0.0.1
AURORA_PORT=8000

# Supabase / Postgres
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# LLM provider: choose one or more
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default gateway model. Keep provider-specific IDs out of application code.
AURORA_DEFAULT_MODEL=
AURORA_EMBEDDING_MODEL=text-embedding-3-small
AURORA_REASONING_MODE=balanced

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Never commit real secrets.
